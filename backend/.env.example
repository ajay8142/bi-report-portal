# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Oracle DB (external — not containerized)
DB_USER=
DB_PASSWORD=
DB_CONNECT_STRING=

# Oracle BI Publisher
BIP_BASE_URL=
BIP_USERNAME=
BIP_PASSWORD=

# Report engine: "bip" (real BI Publisher SOAP) or "reportingtool" (REST shim)
REPORT_ENGINE=bip
REPORTING_TOOL_BASE_URL=
REPORTING_TOOL_USERNAME=
REPORTING_TOOL_PASSWORD=

# CORS — the reverse proxy's public origin
FRONTEND_URL=https://localhost
