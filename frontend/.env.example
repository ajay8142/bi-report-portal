# Local dev (vite dev server talking directly to a locally-run backend):
VITE_API_BASE_URL=http://localhost:5000/api

# Docker/production build: the reverse proxy serves the frontend and proxies
# /api on the same origin, so a relative path is correct and avoids CORS/
# hardcoded-host issues entirely. Passed as a Docker build arg, not read from
# this file, in that case — see frontend/Dockerfile.
# VITE_API_BASE_URL=/api
